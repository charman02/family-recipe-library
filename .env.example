# Required
DATABASE_URL=sqlite:///./recipes.db
JWT_SECRET=change-me

# Photo uploads (optional — the add form's photo box needs these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Extra allowed frontend origins, comma-separated. localhost:5173 and the deployed
# frontend are always allowed, so this is only for an additional frontend host.
CORS_ORIGINS=

# OpenRouter — structures a spoken or pasted recipe into fields (POST /recipes/parse).
#
# OPTIONAL. With no key the endpoint returns ai=false and the frontend falls back to its
# own line-based parser, so /add works exactly as it did before this existed. That is the
# whole point of the fallback: this feature must not be able to break recipe capture.
#
# Server-side only — never a VITE_ variable. Vite inlines those into the bundle, which is
# public at /assets/index-*.js, so a key there could be read and used to spend credits.
OPENROUTER_API_KEY=
# Defaults to deepseek/deepseek-v4-flash-0731. Cheap and fast is right for bounded
# extraction against a fixed schema; a frontier model would buy nothing a user could
# perceive. (Sent with reasoning disabled — see recipe_ai.py.)
OPENROUTER_MODEL=
# Optional, for attribution on the OpenRouter dashboard.
OPENROUTER_REFERER=

# Password-reset email (app/services/email.py). SENDER_EMAIL must be a VERIFIED SES identity
# in us-west-2 or sending fails; APP_URL is the site the emailed reset link points at, so it
# must be the canonical origin, never a deploy alias.
SENDER_EMAIL=noreply@example.com
APP_URL=http://localhost:5173
