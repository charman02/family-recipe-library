# Frontend environment variables (Vite). Copy to .env for local dev, or set in
# your host's dashboard (e.g. Vercel) for production.

# Base URL of the backend API. Defaults to http://localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# Optional: external feedback form (Tally / Google Forms). When set, a
# "Send feedback" button appears on the You/Profile page. Leave unset to hide it.
VITE_FEEDBACK_URL=https://forms.gle/rtQG5QNmgqVmPsTZ7
