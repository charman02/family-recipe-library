{
  "family": "issei-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/issei-api-execution",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/issei-api-task",
  "containerDefinitions": [
    {
      "name": "issei-api",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/issei/prod/DATABASE_URL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/issei/prod/JWT_SECRET"
        },
        {
          "name": "CLOUDINARY_CLOUD_NAME",
          "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/issei/prod/CLOUDINARY_CLOUD_NAME"
        },
        {
          "name": "CLOUDINARY_API_KEY",
          "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/issei/prod/CLOUDINARY_API_KEY"
        },
        {
          "name": "CLOUDINARY_API_SECRET",
          "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/issei/prod/CLOUDINARY_API_SECRET"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/issei/prod/OPENROUTER_API_KEY"
        }
      ],
      "environment": [
        {
          "name": "OPENROUTER_REFERER",
          "value": "https://issei-delta.vercel.app"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://issei-delta.vercel.app"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=2).status==200 else 1)\""],
        "interval": 30,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/issei-api",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
